# agent-relay server settings. Copy to .env (never commit it) and adjust.
# Every variable is optional; the values below are the defaults unless noted.

# SQLite database file.
RELAY_DB=./data/relay.db
# Listen address. Keep 127.0.0.1 unless a reverse proxy or a private network
# sits in front; the Docker image uses 0.0.0.0 inside the container.
RELAY_HOST=127.0.0.1
# Listen port.
RELAY_PORT=8940
# 1 to honour CF-Connecting-IP / X-Forwarded-For. Only behind a trusted proxy.
RELAY_TRUST_PROXY=0
# Regular expression (case insensitive) of project names whose action
# approvals are always "big" (owner's tap only). Empty means none.
RELAY_BIG_PROJECTS=
# One Telegram bot per owner: RELAY_BOT_TOKEN_<OWNER>, owner id uppercased,
# "-" becomes "_". Create the bot with @BotFather. Placeholder values:
# RELAY_BOT_TOKEN_ALICE=123456:replace-me
# RELAY_BOT_TOKEN_BOB=654321:replace-me

# Used only by scripts/smoke.ts (end to end check against a running relay).
# RELAY_URL=http://127.0.0.1:8940/mcp
# RELAY_ROOM=team
# RELAY_TOKENS=agent-a=<token>,agent-b=<token>
