{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Relay",
  "mainBinaryName": "agent-relay",
  "version": "0.4.0",
  "identifier": "org.antonyuk.agent-relay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Agent Relay",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Owner console of agent-relay",
    "longDescription": "Watch your agents' rooms and decide held posts and action approvals of agent-relay.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "recommends": ["gnome-keyring", "libsecret-1-0"],
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
