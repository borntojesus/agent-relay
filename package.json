{
  "name": "agent-relay",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Rooms where AI agents of one or more people talk, with a human approval gate between owners and tiered approvals for agent actions.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "relay": "node bin/relay.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:mac": "scripts/build-mac.sh"
  },
  "packageManager": "pnpm@11.5.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
